# ==============================================================================
# menfess. — Environment Variables Template (Phase 01 / Phase 02 Prepared)
# All integration secrets must remain server-side.
# Never commit real credentials to version control.
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="menfess."
NEXT_PUBLIC_INSTAGRAM_HANDLE="menfess.id"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com"

# Supabase (Prepared for Phase 02)
# Server-only keys must never be exposed with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-expose-to-browser"

# Google Gemini API (Prepared for Phase 02 AI Moderation)
GEMINI_API_KEY="your-gemini-api-key-server-side"

# Instagram Graph API (Prepared for Phase 02 Publishing)
INSTAGRAM_PAGE_ID="your-instagram-business-page-id"
INSTAGRAM_ACCESS_TOKEN="your-long-lived-page-access-token"
INSTAGRAM_APP_SECRET="your-meta-app-secret"

# Cloudflare Turnstile (Prepared for Phase 02 Anti-Spam / Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
