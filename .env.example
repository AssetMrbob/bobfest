# ==============================================================================
# menfess. — Environment Variables Template (Phase 02 Architecture)
# All integration secrets must remain server-side.
# Never commit real credentials to version control.
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="menfess."
NEXT_PUBLIC_INSTAGRAM_HANDLE="menfess.id"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com"
APP_SECRET="your-strong-random-server-secret-for-hmac-hashing"

# Supabase (Phase 02 Database & Authentication)
# Obtain from Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only secret key (Never expose with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY="sb_secret_..."

# Cloudflare Turnstile (Bot & Anti-Spam Protection)
# Obtain from Cloudflare Dashboard → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Google Gemini API (Phase 05 AI Moderation)
GEMINI_API_KEY="your-gemini-api-key-server-side"
GEMINI_MODEL="gemini-2.5-flash-lite"

# Instagram Graph API (Prepared for Phase 04 Publishing)
INSTAGRAM_PAGE_ID="your-instagram-business-page-id"
INSTAGRAM_ACCESS_TOKEN="your-long-lived-page-access-token"
INSTAGRAM_APP_SECRET="your-meta-app-secret"
