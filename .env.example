# ==============================================================================
# Kampung Inggris Fess — Environment Variables Template (Phase 07 Multi-Platform)
# All integration secrets must remain server-side.
# Never commit real credentials to version control.
# ==============================================================================

# Application Branding
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kampung Inggris Fess"
NEXT_PUBLIC_INSTAGRAM_HANDLE="kampunginggrisfess"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/kampunginggrisfess/"
NEXT_PUBLIC_THREADS_HANDLE="kampunginggrisfess"
NEXT_PUBLIC_THREADS_URL="https://www.threads.com/@kampunginggrisfess"
APP_SECRET="your-strong-random-server-secret-for-hmac-hashing-and-encryption"

# Supabase (Database, Auth, and Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Cloudflare Turnstile (Bot & Anti-Spam Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Google Gemini API (Phase 05 AI Moderation)
GEMINI_API_KEY="your-gemini-api-key-server-side"
GEMINI_MODEL="gemini-2.5-flash-lite"

# Instagram Graph API (Unified Login - Configurable Version)
# Unified Login uses graph.facebook.com with instagram_basic & instagram_content_publish scopes
INSTAGRAM_API_VERSION="v21.0"
INSTAGRAM_USER_ID="17841480301270114"
INSTAGRAM_USERNAME="kampunginggrisfess"
INSTAGRAM_ACCESS_TOKEN="your-unified-login-access-token"

# Threads Official API (graph.threads.net - v1.0)
THREADS_APP_ID="1175984308212285"
THREADS_USER_ID="29202039439462395"
THREADS_USERNAME="kampunginggrisfess"
THREADS_ACCESS_TOKEN="your-long-lived-threads-access-token"
